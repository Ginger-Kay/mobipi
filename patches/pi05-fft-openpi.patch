+"""Task-owned loopback inference service; simulator stays in its own env."""
+import argparse
+from datetime import datetime, timezone
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from io import BytesIO
+import json
+import os
+from pathlib import Path
+import time
+import jax
+import jax.numpy as jnp
+import numpy as np
+from openpi.models import model, pi0_config, tokenizer
+from openpi.shared import nnx_utils
+from pi05_fft_data import CAMERAS, normalize_vector, unnormalize_vector
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--checkpoint',type=Path,required=True);p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--lora',action='store_true');p.add_argument('--port',type=int,default=8865);p.add_argument('--max-seconds',type=int,default=7200);p.add_argument('--max-queries',type=int,default=4000);a=p.parse_args()
+    a.output.mkdir(exist_ok=False);started=datetime.now(timezone.utc).isoformat();deadline=time.monotonic()+a.max_seconds
+    cfg=pi0_config.Pi0Config(pi05=True,action_horizon=10,paligemma_variant='gemma_2b_lora' if a.lora else 'gemma_2b',action_expert_variant='gemma_300m_lora' if a.lora else 'gemma_300m')
+    net=cfg.load(model.restore_params(a.checkpoint/'params',dtype=jnp.bfloat16));net.eval();sample=nnx_utils.module_jit(net.sample_actions)
+    stats=json.loads((a.checkpoint/'custom-norm-stats.json').read_text());tok=tokenizer.PaligemmaTokenizer(max_len=200)
+    adapter=json.loads((a.checkpoint/'policy-adapter-config.json').read_text()) if (a.checkpoint/'policy-adapter-config.json').exists() else {'action_representation':'absolute_query_base'}
+    context=dict(checkpoint=str(a.checkpoint),queries=0,key=jax.random.key(20261008),stop=False)
+    binding=dict(started_at=started,pid=os.getpid(),port=a.port,host='127.0.0.1',checkpoint=str(a.checkpoint),python=__import__('sys').executable,
+        max_seconds=a.max_seconds,max_queries=a.max_queries,action_horizon=10,flow_steps=10,execute_prefix=5,action_width=8,padded_width=32,
+        normalizer='pi05_harness_data normalize_vector/unnormalize_vector frozen local quantiles and constant channel mapping',discrete_state_input=True,framework='JAX',status='loading',action_representation=adapter['action_representation'])
+    (a.output/'binding.json').write_text(json.dumps(binding,indent=2)+'\n')
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            body=json.dumps(dict(binding,queries=context['queries'],status='ready')).encode();self.send_response(200);self.end_headers();self.wfile.write(body)
+        def do_POST(self):
+            raw=self.rfile.read(int(self.headers['Content-Length']))
+            if self.path=='/reset':
+                seed=int(json.loads(raw)['policy_sampling_seed']);context['key']=jax.random.key(seed)
+                self.send_response(200);self.end_headers();self.wfile.write(b'{}');return
+            if self.path=='/finish-declared-units':
+                context['stop']=True;self.send_response(200);self.end_headers();self.wfile.write(b'{}');return
+            try:
+                z=np.load(BytesIO(raw),allow_pickle=False);state=normalize_vector(z['state'],stats['state'])
+                tokens,mask=tok.tokenize(str(z['prompt']),state)
+                obs=model.Observation(images={k:jnp.asarray(z[k])[None].astype(jnp.float32)/255*2-1 for k in CAMERAS},
+                    image_masks={k:jnp.ones((1,),bool) for k in CAMERAS},state=jnp.asarray(state)[None],
+                    tokenized_prompt=jnp.asarray(tokens)[None],tokenized_prompt_mask=jnp.asarray(mask)[None])
+                context['key'],key=jax.random.split(context['key']);t=time.monotonic()
+                normalized=np.asarray(sample(key,obs,num_steps=10))[0];duration=time.monotonic()-t
+                assert normalized.shape==(10,32) and np.isfinite(normalized).all()
+                actions=unnormalize_vector(normalized,stats['actions']);context['queries']+=1
+                response=BytesIO();np.savez(response,normalized=normalized,actions=actions,query_seconds=duration,query_id=context['queries'])
+                self.send_response(200);self.end_headers();self.wfile.write(response.getvalue())
+                print(json.dumps(dict(at=datetime.now(timezone.utc).isoformat(),query=context['queries'],seconds=duration)),flush=True)
+            except Exception as exc:
+                self.send_response(500);self.end_headers();self.wfile.write(str(exc).encode());raise
+    server=HTTPServer(('127.0.0.1',a.port),Handler);server.timeout=1
+    (a.output/'ready.json').write_text(json.dumps(dict(binding,status='ready',at=datetime.now(timezone.utc).isoformat()),indent=2)+'\n')
+    print('READY',a.port,a.checkpoint,flush=True)
+    while not context['stop'] and time.monotonic()<deadline and context['queries']<a.max_queries:server.handle_request()
+    server.server_close();(a.output/'completed.json').write_text(json.dumps(dict(ended_at=datetime.now(timezone.utc).isoformat(),queries=context['queries'],declared_units_finished=context['stop'],bounded_exit=True),indent=2)+'\n')
+
+
+if __name__=='__main__':main()

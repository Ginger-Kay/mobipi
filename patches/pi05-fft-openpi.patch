+def action_velocity_loss(prediction, target, valid_width=None):
+    """Reduce flow velocity error over valid robot channels only."""
+    error = jnp.square(prediction - target)
+    if valid_width is not None:
+        error = error[..., :valid_width]
+    return jnp.mean(error, axis=-1)

+"""Official JAX full-parameter FSDP with a local native action loader.
+
+All multi-GPU execution is reachable only through the researcher's launch card.
+"""
+import argparse
+import dataclasses
+from datetime import datetime, timezone
+import functools
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import time
+import traceback
+import threading
+import numpy as np
+import jax
+import jax.numpy as jnp
+from flax import nnx

+"""CPU semantic checks; no GPU forward, gradient update, or environment step."""
+import argparse
+from datetime import datetime,timezone
+import json
+from pathlib import Path
+import numpy as np
+import jax
+import jax.numpy as jnp
+from openpi.models.pi0 import action_velocity_loss
+from openpi.training import sharding
+from pi05_fft_train import recipe
+from pi05_fft_data import LocalDemoLoader,normalize_vector,unnormalize_vector
+import train as official
+
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--run',type=Path,required=True);a=ap.parse_args()
+    assert all(d.platform=='cpu' for d in jax.devices())
+    key=jax.random.key(17);x=jax.random.normal(key,(2,10,32));y=x+.2
+    first=action_velocity_loss(x,y,8)
+    altered=y.at[...,8:].set(1e6)
+    assert np.array_equal(first,action_velocity_loss(x,altered,8))
+    gradient=jax.grad(lambda p:jnp.sum(action_velocity_loss(p,altered,8)))(x)
+    assert np.max(abs(np.asarray(gradient[...,8:])))==0
+    assert np.max(abs(np.asarray(gradient[...,:8])))>0
+    binding=json.loads((a.run/'inventory/dataset-binding.json').read_text())
+    loader=LocalDemoLoader(binding['dataset'],32)
+    batch=loader.next()
+    assert batch[1].shape==(32,10,32) and np.isfinite(batch[1]).all()
+    assert np.max(abs(batch[1][...,8:]))==0
+    physical=unnormalize_vector(batch[1],loader.stats['actions'])
+    check=normalize_vector(physical,loader.stats['actions'])
+    assert np.max(abs(check-batch[1]))<=1e-5
+    specs={}
+    for devices in (2,4):
+        cfg=recipe(a.run,'cpu-shape',devices,32,100)
+        mesh=sharding.make_mesh(devices)
+        shape,spec=official.init_train_state(cfg,jax.random.key(17),mesh,resume=True)
+        param_spec=[str(v.spec) for v in jax.tree.leaves(spec.params) if hasattr(v,'spec')]
+        opt_spec=[str(v.spec) for v in jax.tree.leaves(spec.opt_state) if hasattr(v,'spec')]
+        assert any('fsdp' in x for x in param_spec) and any('fsdp' in x for x in opt_spec)
+        specs[str(devices)]=dict(mesh_shape=dict(mesh.shape),parameter_shards=sum('fsdp' in x for x in param_spec),
+            optimizer_shards=sum('fsdp' in x for x in opt_spec),resource_semantics='CPU abstract shape only; actual GPU memory/communication unrun')
+    receipt=dict(at=datetime.now(timezone.utc).isoformat(),passed=True,padding_loss_and_gradient_invariant=True,
+        action_normalization_roundtrip_max=float(np.max(abs(check-batch[1]))),loader_global_batch_shape=[32,10,32],
+        cpu_abstract_FSDP=specs,GPU_training_updates=0,policy_forward_calls=0,env_step_calls=0)
+    (a.run/'preflight/cpu-executable-check.json').write_text(json.dumps(receipt,indent=2)+'\n')
+    print(json.dumps(receipt),flush=True)
+
+
+if __name__=='__main__':main()

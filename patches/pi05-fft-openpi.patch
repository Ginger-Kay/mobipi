+"""CPU-only source, native target, mask and full-parameter shape checks."""
+import argparse
+from collections import Counter
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import numpy as np
+from scipy.spatial.transform import Rotation
+import jax
+from flax import nnx
+from openpi.models import pi0_config
+from openpi.training import config
+
+
+def now(): return datetime.now(timezone.utc).isoformat()
+def write(p,d): p.write_text(json.dumps(d,indent=2)+'\n')
+
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('--run',type=Path,required=True);a=ap.parse_args()
+    binding=json.loads((a.run/'inventory/dataset-binding.json').read_text())
+    directory=Path(binding['dataset']); manifest=json.loads((directory/'dataset.json').read_text())
+    split=json.loads((a.run/'inventory/source-split.json').read_text())
+    reserved=set(split['reserved_development_evaluation_ancestors'])
+    episodes=manifest['episodes'];parents={e['parent_group'] for e in episodes}
+    assert not reserved & parents
+    assert all(e['source_use'] in ('policy-fit','policy-fit-only') and not e['obc_outcome_label'] for e in episodes)
+    stats=json.loads((directory/'norm-stats.json').read_text())
+    rows=[];states=[];targets=[];state_weights=[];action_weights=[]
+    parent_counts=Counter(e['parent_group'] for e in episodes)
+    maxp=maxr=0.;N=0
+    for e in episodes:
+        root=Path(e['derived']);z=np.load(root/'commands.npz',allow_pickle=False)
+        frames=len(z['state']);windows=frames-9
+        assert windows==e['windows'] and frames==e['frames'] and windows>0
+        assert all(np.isfinite(z[k]).all() for k in z.files)
+        for cam in ('base_0_rgb','left_wrist_0_rgb','right_wrist_0_rgb'):
+            im=np.load(root/(cam+'.npy'),mmap_mode='r')
+            assert im.shape==(frames,224,224,3) and im.dtype==np.uint8,(e['record_id'],cam,im.shape,im.dtype)
+        pos=[];rot=[]
+        for offset in range(10):
+            R=z['base_R'][:windows];p=z['base_p'][:windows];state=z['state'][:windows]
+            relative_p=np.einsum('tij,tj->ti',R.transpose(0,2,1),z['target_world_p'][offset:offset+windows]-p)-state[:,:3]
+            initial=Rotation.from_rotvec(state[:,3:6]).as_matrix()
+            mats=R.transpose(0,2,1)@z['target_world_R'][offset:offset+windows]
+            relative_r=Rotation.from_matrix(mats@initial.transpose(0,2,1)).as_rotvec()
+            pos.append(relative_p);rot.append(relative_r)
+        physical=np.zeros((windows,10,32),np.float32)
+        physical[:,:,:3]=np.stack(pos,axis=1);physical[:,:,3:6]=np.stack(rot,axis=1)
+        physical[:,:,6:8]=np.stack([z['grip_torso'][o:o+windows] for o in range(10)],axis=1)
+        for t in sorted({0,windows//2,windows-1}):
+            R=z['base_R'][t];eef=z['base_p'][t]+R@z['state'][t,:3]
+            eef_R=R@Rotation.from_rotvec(z['state'][t,3:6]).as_matrix()
+            rp=eef+physical[t,:,:3]@R.T
+            rr=R@Rotation.from_rotvec(physical[t,:,3:6]).as_matrix()@R.T@eef_R
+            maxp=max(maxp,float(np.max(abs(rp-z['target_world_p'][t:t+10]))))
+            maxr=max(maxr,float(np.max(abs(rr-z['target_world_R'][t:t+10]))))
+        assert maxp<=1e-6 and maxr<=1e-6
+        weight=1/len(parents)/parent_counts[e['parent_group']]/windows
+        states.append(z['state'][:windows]);targets.append(physical.reshape(-1,32))
+        state_weights.append(np.full(windows,weight));action_weights.append(np.full(windows*10,weight/10))
+        rows.append(dict(record_id=e['record_id'],parent_group=e['parent_group'],task=e['task'],route=e['route'],frames=frames,windows=windows,
+            command_sha256=hashlib.sha256((root/'commands.npz').read_bytes()).hexdigest(),policy_input_current_frame_only=True,
+            no_cross_episode_chunks=True,action_valid_mask=[True]*8+[False]*24,state_valid_width=22))
+        N+=windows
+    # Quantiles follow the actual uniform parent -> episode -> window sampler.
+    def weighted_quantile(x,w,q):
+        order=np.argsort(x,kind='stable');v=x[order];c=np.cumsum(w[order]);c/=c[-1]
+        return float(np.interp(q,c,v))
+    for key,blocks,weights,width in [('state',states,state_weights,22),('actions',targets,action_weights,8)]:
+        x=np.concatenate(blocks);w=np.concatenate(weights)
+        low=[weighted_quantile(x[:,i],w,.01) for i in range(32)]
+        high=[weighted_quantile(x[:,i],w,.99) for i in range(32)]
+        stats[key]=dict(q01=low,q99=high,valid_width=width,constant=[abs(b-c)<1e-8 for b,c in zip(low,high)])
+    write(directory/'norm-stats.json',stats)
+    cfg=config.TrainConfig(name='mobiwam_pi05_full_ft_v1',model=pi0_config.Pi0Config(pi05=True,action_horizon=10,action_loss_dim=8),
+        freeze_filter=nnx.Nothing,ema_decay=None,seed=17,batch_size=32,fsdp_devices=4)
+    abstract=nnx.eval_shape(cfg.model.create,jax.random.key(17));allparams=nnx.state(abstract,nnx.Param)
+    trainable=allparams.filter(cfg.trainable_filter);frozen=allparams.filter(cfg.freeze_filter)
+    leaves=[dict(path='/'.join(map(str,k)),shape=list(v.value.shape),dtype=str(v.value.dtype),count=int(np.prod(v.value.shape)))
+        for k,v in trainable.flat_state().items()]
+    assert len(frozen.flat_state())==0 and not any('lora' in r['path'] for r in leaves)
+    assert any('img' in r['path'] for r in leaves) and any('llm' in r['path'] for r in leaves)
+    write(a.run/'preflight/cpu-model-config.json',dict(at=now(),total=sum(r['count'] for r in leaves),trainable=sum(r['count'] for r in leaves),
+        frozen=0,paths=leaves,bf16_compute=cfg.model.dtype,parameters='float32 per official initialization; verified abstractly',
+        real_updates='unrun; S2 manual FSDP diagnostic required',action_loss_dim=8,EMA=None,backbones=dict(vision='SigLIP',language='gemma_2b',action='gemma_300m')))
+    binding.update(valid_windows=N,independent_episodes=len(episodes),parent_groups=len(parents),created_at=now(),
+        norm_hierarchy='uniform parent -> original episode -> valid query window -> equally weighted10 target timesteps',
+        norm_train_only=True,action_valid_mask=[True]*8+[False]*24,norm_sha256=hashlib.sha256((directory/'norm-stats.json').read_bytes()).hexdigest())
+    write(a.run/'inventory/dataset-binding.json',binding)
+    write(a.run/'preflight/cpu-interface.json',dict(at=now(),passed=True,N=N,episodes=len(episodes),parents=len(parents),
+        heldout_parent_leakage=False,native_target_adapter_position_max_m=maxp,native_target_adapter_rotation_matrix_max=maxr,
+        effective_actions=8,padded_actions=32,no_padding_supervision=True,no_cross_episode_chunks=True,records=rows,
+        command_lineage='immutable native commanded goals; no achieved future EEF displacement substituted',
+        action_fit_and_task_capability='unrun; requires S2 and counted development slots',policy_forward_calls=0,env_step_calls=0))
+    print(json.dumps(dict(status='passed',episodes=len(episodes),parents=len(parents),N=N,total_trainable=sum(r['count'] for r in leaves),maxp=maxp,maxr=maxr)))
+
+
+if __name__=='__main__': main()

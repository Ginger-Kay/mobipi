+    ap.add_argument('--wall-seconds',type=int,default=14400);ap.add_argument('--dataset-binding',type=Path)
+    ap.add_argument('--init-checkpoint',type=Path,required=True);ap.add_argument('--checkpoint-root',type=Path,required=True);a=ap.parse_args()
+    out=a.run/'policy'/a.fit_id;out.mkdir(exist_ok=False)
+    binding=json.loads((a.dataset_binding or a.run/'data/dataset-binding.json').read_text());loader=LocalDemoLoader(binding['dataset'],a.batch)
+    ckpt_path=a.checkpoint_root/a.fit_id
+    allow=nnx_utils.PathRegex('.*lora.*|action_in_proj/.*|action_out_proj/.*|time_mlp_in/.*|time_mlp_out/.*')
+    cfg=config.TrainConfig(name='mobiwam_pi05_dual_lora_v1',exp_name=a.fit_id,
+        model=pi0_config.Pi0Config(pi05=True,action_horizon=10,paligemma_variant='gemma_2b_lora',action_expert_variant='gemma_300m_lora'),
+        freeze_filter=nnx.Not(allow),weight_loader=weight_loaders.CheckpointWeightLoader(str(a.init_checkpoint/'params')),
+        lr_schedule=optimizer.CosineDecaySchedule(warmup_steps=min(100,int(.05*a.steps)),peak_lr=5e-5,decay_steps=a.steps,decay_lr=5e-6),
+        optimizer=optimizer.AdamW(),ema_decay=None,batch_size=a.batch,seed=17,num_train_steps=a.steps,wandb_enabled=False,
+        assets_base_dir=str(a.run/'policy/assets'),checkpoint_base_dir=str(ckpt_path.parent),fsdp_devices=1)
+    mesh=sharding.make_mesh(1);started=now();deadline=time.monotonic()+a.wall_seconds
+    write(out/'freeze.json',dict(created_at=started,fit_id=a.fit_id,diagnostic=a.diagnostic,steps=a.steps,batch=a.batch,training_seed=17,
+        action_horizon=10,execute_prefix=5,flow_steps=10,pi05=True,discrete_state_input=True,allowlist_regex=allow.pattern.pattern,
+        vision_and_original_transformer_frozen=True,base_checkpoint=str(a.init_checkpoint),new_optimizer_schedule=True,old_optimizer_loaded=False,dataset=binding['dataset'],parent_groups=binding['parent_groups'],windows=binding['valid_windows'],
+        lr_peak=5e-5,lr_end=5e-6,warmup=min(100,int(.05*a.steps)),ema=None,max_wall_seconds=a.wall_seconds,checkpoint_root=str(ckpt_path),
+        model_compute_dtype='bfloat16',optimizer='official AdamW .9/.95/1e-8/wd1e-10/clip1',dev_selection='diagnostic not a final candidate' if a.diagnostic else 'predeclared checkpoints quarter/half/final; dev safe success then common success cost then earlier'))
+    def event(stage,**kw):
+        item=dict(at=now(),stage=stage,pid=os.getpid(),**kw);print(json.dumps(item),flush=True);write(out/'status.json',item)
+    try:
+        event('initialize',python=__import__('sys').executable,devices=str(jax.devices()))
+        with sharding.set_mesh(mesh):state,_=official.init_train_state(cfg,jax.random.key(17),mesh,resume=False)
+        jax.block_until_ready(state.step)
+        trainable=state.params.filter(cfg.trainable_filter);frozen=state.params.filter(cfg.freeze_filter)
+        paths=[dict(path='/'.join(map(str,k)),shape=list(v.value.shape),dtype=str(v.value.dtype),count=int(v.value.size)) for k,v in trainable.flat_state().items()]
+        assert all(('lora' in x['path'] or x['path'].split('/')[0] in ('action_in_proj','action_out_proj','time_mlp_in','time_mlp_out')) for x in paths)
+        assert not any('img' in x['path'] for x in paths)
+        write(out/'trainable-parameters.json',dict(paths=paths,total=sum(x['count'] for x in paths),frozen_total=sum(v.value.size for k,v in frozen.flat_state().items()),
+            frozen_path_count=len(frozen.flat_state()),optimizer_state_dtypes=sorted({str(x.dtype) for x in jax.tree.leaves(state.opt_state) if hasattr(x,'dtype')})))
+        before_frozen=digest_params(frozen)
+        write(out/'frozen-leaf-sha256-before.json',before_frozen)
+        before_trainable={str(k):np.asarray(v.value).copy() for k,v in trainable.flat_state().items()} if a.diagnostic else None
+        manager,_=checkpoints.initialize_checkpoint_dir(ckpt_path,keep_period=1,overwrite=False,resume=False)
+        step_fn=jax.jit(functools.partial(official.train_step,cfg),donate_argnums=(1,))
+        timings=[];saves=[max(1,a.steps//2),a.steps] if not a.diagnostic else [a.steps]
+        log=(out/'metrics.jsonl').open('x');event('train',trainable_parameters=sum(x['count'] for x in paths),save_steps=saves)
+        last_save=0
+        with sharding.set_mesh(mesh):

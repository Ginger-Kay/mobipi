+"""Frozen local demo loader and explicit current-base nominal action format."""
+import json
+from pathlib import Path
+import numpy as np
+from scipy.spatial.transform import Rotation
+from openpi.models import tokenizer, model
+from openpi.shared import normalize
+from openpi.training.config import DataConfig
+
+CAMERAS=('base_0_rgb','left_wrist_0_rgb','right_wrist_0_rgb')
+
+
+def normalize_vector(x, stats):
+    low=np.asarray(stats['q01'],np.float32);high=np.asarray(stats['q99'],np.float32)
+    const=np.asarray(stats['constant']);scale=high-low
+    result=(x-low)*2/np.where(const,1,scale)-1
+    return np.where(const,0,result).astype(np.float32)
+
+
+def unnormalize_vector(x, stats):
+    low=np.asarray(stats['q01'],np.float32);high=np.asarray(stats['q99'],np.float32)
+    # A constant physical channel remains the training constant. Padding is
+    # ignored by the robot adapter and never counted as a real robot dimension.
+    return np.where(np.asarray(stats['constant']),low,(x+1)/2*(high-low)+low).astype(np.float32)
+
+
+class LocalDemoLoader:
+    def __init__(self, dataset, batch_size=8):
+        self.directory=Path(dataset)
+        self.manifest=json.loads((self.directory/'dataset.json').read_text())
+        self.stats=json.loads((self.directory/'norm-stats.json').read_text())
+        self.batch_size=batch_size;self.rng=np.random.default_rng(17)
+        self.tokenizer=tokenizer.PaligemmaTokenizer(max_len=200)
+        self.episodes=[];self.windows=[]
+        for e, rec in enumerate(self.manifest['episodes']):
+            d=Path(rec['derived']);commands=np.load(d/'commands.npz',allow_pickle=False)
+            self.episodes.append(dict(meta=rec,data=commands,images={k:np.load(d/(k+'.npy'),mmap_mode='r') for k in CAMERAS}))
+            self.windows.extend((e,t) for t in range(rec['frames']-9))
+        self.order=self.rng.permutation(len(self.windows));self.offset=0
+        self.balanced=self.manifest.get('sampling','').startswith('uniform Source')
+        self.parent_episodes={}
+        for i,ep in enumerate(self.episodes):self.parent_episodes.setdefault(ep['meta']['parent_group'],[]).append(i)
+        self.parents=sorted(self.parent_episodes)
+        self.exposure={ep['meta']['record_id']:0 for ep in self.episodes}
+
+    def next(self):
+        if self.offset+self.batch_size>len(self.order):
+            self.order=self.rng.permutation(len(self.windows));self.offset=0
+        chosen=self.order[self.offset:self.offset+self.batch_size];self.offset+=self.batch_size
+        if self.balanced:
+            samples=[]
+            for _ in range(self.batch_size):
+                parent=self.parents[int(self.rng.integers(len(self.parents)))]
+                pool=self.parent_episodes[parent];e=pool[int(self.rng.integers(len(pool)))];t=int(self.rng.integers(self.episodes[e]['meta']['windows']))
+                samples.append((e,t))
+        else:samples=[self.windows[w] for w in chosen]
+        inputs=[];actions=[]
+        for e,t in samples:
+            ep=self.episodes[e];self.exposure[ep['meta']['record_id']]+=1;data=ep['data'];R=data['base_R'][t];p=data['base_p'][t]
+            target=np.zeros((10,32),np.float32)
+            target[:,:3]=(data['target_world_p'][t:t+10]-p)@R
+            mats=np.einsum('ij,tjk->tik',R.T,data['target_world_R'][t:t+10])
+            target[:,3:6]=Rotation.from_matrix(mats).as_rotvec();target[:,6:8]=data['grip_torso'][t:t+10]
+            if self.manifest.get('action_representation')=='query_relative_eef':
+                target[:,:3]-=data['state'][t,:3]
+                initial_R=Rotation.from_rotvec(data['state'][t,3:6]).as_matrix()
+                target[:,3:6]=Rotation.from_matrix(mats@initial_R.T).as_rotvec()
+            state=normalize_vector(data['state'][t],self.stats['state'])
+            tokens,mask=self.tokenizer.tokenize(ep['meta']['prompt'],state)
+            inputs.append(dict(state=state,tokens=tokens,mask=mask,images={k:np.asarray(ep['images'][k][t]) for k in CAMERAS}))
+            actions.append(normalize_vector(target,self.stats['actions']))
+        obs=model.Observation(images={k:np.stack([x['images'][k] for x in inputs]).astype(np.float32)/255*2-1 for k in CAMERAS},
+            image_masks={k:np.ones(self.batch_size,bool) for k in CAMERAS},state=np.stack([x['state'] for x in inputs]),
+            tokenized_prompt=np.stack([x['tokens'] for x in inputs]),tokenized_prompt_mask=np.stack([x['mask'] for x in inputs]))
+        return obs,np.stack(actions)
+
+    def data_config(self):
+        norms={k:normalize.NormStats(mean=np.zeros(32),std=np.ones(32),q01=np.asarray(v['q01']),q99=np.asarray(v['q99'])) for k,v in self.stats.items()}
+        return DataConfig(asset_id='mobiwam-static-command-v1',norm_stats=norms)

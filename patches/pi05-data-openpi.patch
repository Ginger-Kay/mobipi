+                state,info=step_fn(jax.random.key(17),state,batch);info=jax.device_get(info);dt=time.monotonic()-t
+                if not np.isfinite(float(info['loss'])) or not np.isfinite(float(info['grad_norm'])):raise FloatingPointError(str(info))
+                if i>1:timings.append(dt)
+                item=dict(at=now(),step=i,loss=float(info['loss']),grad_norm=float(info['grad_norm']),synchronized_step_seconds=dt)
+                log.write(json.dumps(item)+'\n');log.flush()
+                if i==1 or i%5==0:event('train',**{k:v for k,v in item.items() if k!='at'})
+                timed_out=time.monotonic()>=deadline
+                if i in saves or timed_out:
+                    checkpoints.save_state(manager,state,loader,i);manager.wait_until_finished();last_save=i
+                    shutil.copy2(Path(binding['dataset'])/'norm-stats.json',ckpt_path/str(i)/'custom-norm-stats.json')
+                    write(ckpt_path/str(i)/'policy-adapter-config.json',dict(action_representation=binding.get('action_representation','absolute_query_base'),dataset=binding['dataset']))
+                    event('checkpoint_saved',step=i,path=str(ckpt_path/str(i)))
+                if timed_out:break
+        log.close();manager.wait_until_finished()

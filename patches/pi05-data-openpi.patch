+"""Full checkpoint restore and real recorded sensor forward; no task execution."""
+import argparse
+import json
+import os
+from pathlib import Path
+import time
+import traceback
+from datetime import datetime, timezone
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+from flax import nnx
+from openpi.models import model as model_lib, pi0_config, tokenizer
+from openpi.shared import nnx_utils
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--run', type=Path, required=True)
+    a = p.parse_args()
+    out = a.run / 'policy/full-load-real-forward'
+    out.mkdir(exist_ok=False)
+    started = datetime.now(timezone.utc).isoformat()
+    def event(stage, **kw):
+        rec = dict(at=datetime.now(timezone.utc).isoformat(), stage=stage, pid=os.getpid(), **kw)
+        print(json.dumps(rec), flush=True)
+        (out / 'status.json').write_text(json.dumps(rec, indent=2) + '\n')
+    try:
+        event('restoring', python=__import__('sys').executable, jax=jax.__version__, devices=str(jax.devices()))
+        cfg = pi0_config.Pi0Config(pi05=True, action_horizon=10)
+        t = time.monotonic()
+        params = model_lib.restore_params('/share/personal/chensiyu/haokaijiang/MobiWAM/checkpoints/pi05_origin/params', dtype=jnp.bfloat16)
+        net = cfg.load(params)
+        net.eval()
+        state = nnx.state(net)
+        count = sum(x.value.size for x in jax.tree.leaves(state) if hasattr(x, 'value'))
+        event('loaded', load_seconds=time.monotonic()-t, parameter_leaf_count=len(jax.tree.leaves(state)))
+        input_path = a.run / 'policy/real-observation.npz'
+        deadline = time.monotonic() + 900
+        while not input_path.exists():
+            if time.monotonic() > deadline:
+                raise RuntimeError('real observation not ready within 15 minutes')
+            time.sleep(2)
+        z = np.load(input_path, allow_pickle=False)
+        tok = tokenizer.PaligemmaTokenizer(max_len=200)
+        tokens, mask = tok.tokenize(str(z['prompt']), z['state'])
+        keys = ('base_0_rgb', 'left_wrist_0_rgb', 'right_wrist_0_rgb')
+        obs = model_lib.Observation(images={k:jnp.asarray(z[k])[None].astype(jnp.float32)/255*2-1 for k in keys},
+            image_masks={k:jnp.ones((1,), dtype=bool) for k in keys}, state=jnp.asarray(z['state'])[None],
+            tokenized_prompt=jnp.asarray(tokens)[None], tokenized_prompt_mask=jnp.asarray(mask)[None])
+        sample = nnx_utils.module_jit(net.sample_actions)
+        durations = []
+        for i in range(3):
+            t = time.monotonic()
+            actions = np.asarray(sample(jax.random.key(20261006+i), obs, num_steps=10))
+            durations.append(time.monotonic()-t)
+            assert actions.shape == (1,10,32) and np.isfinite(actions).all()
+            np.save(out / f'raw-normalized-actions-{i}.npy', actions)
+            event('real_forward', query=i+1, synchronized_seconds=durations[-1], shape=list(actions.shape))
+        rec = dict(started_at=started, ended_at=datetime.now(timezone.utc).isoformat(), status='passed',
+            complete_checkpoint_loaded=True, real_recorded_observation=True, action_shape=[1,10,32],
+            synchronized_query_seconds=durations, input=str(input_path), input_manifest=str(input_path.with_suffix('.json')),
+            robot_calibrated=False, task_capability=False, semantic_note='Official base has no current robot normalization; raw normalized outputs are smoke only',
+            device_uuid=os.environ.get('CUDA_VISIBLE_DEVICES'), framework='JAX/OCDBT', policy_sampling_seed=20261006)
+        (out / 'result.json').write_text(json.dumps(rec, indent=2)+'\n')
+        event('completed')
+    except BaseException:
+        (out/'failure.json').write_text(json.dumps(dict(at=datetime.now(timezone.utc).isoformat(), traceback=traceback.format_exc()),indent=2)+'\n')
+        traceback.print_exc()
+        raise
+
+
+if __name__ == '__main__':
+    main()
